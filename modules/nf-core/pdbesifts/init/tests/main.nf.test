nextflow_process {

    name "Test Process PDBESIFTS_INIT"
    script "../main.nf"
    process "PDBESIFTS_INIT"

    tag "modules"
    tag "modules_nfcore"
    tag "pdbesifts"
    tag "pdbesifts/init"

    test("sifts - init") {

        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["sifts_config"])).match() }
            )
        }

    }

    test("sifts - init - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ id:'test' ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
