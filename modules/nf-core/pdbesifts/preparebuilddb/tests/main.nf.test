nextflow_process {

    name "Test Process PDBESIFTS_PREPAREBUILDDB"
    script "../main.nf"
    process "PDBESIFTS_PREPAREBUILDDB"

    tag "modules"
    tag "modules_nfcore"
    tag "pdbesifts"
    tag "pdbesifts/preparebuilddb"

    test("yeast - fasta") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/database/yeast_UPS.fasta', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    path(process.out.fasta[0][1]).linesGzip[0..4],
                    process.out.tax_mapping,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("yeast - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/database/yeast_UPS.fasta', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("no input - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [] ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
