nextflow_process {

    name "Test Process PDBESIFTS_PREPAREBUILDDB"
    script "../main.nf"
    process "PDBESIFTS_PREPAREBUILDDB"

    tag "modules"
    tag "modules_nfcore"
    tag "pdbesifts"
    tag "pdbesifts/preparebuilddb"

    test("no input") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [] ]
                """
            }
        }

        then {
            assert process.success
            // Swiss-Prot changes every release, so only file names are stable
            assertAll(
                { assert snapshot(
                    file(process.out.fasta[0][1]).name,
                    file(process.out.tax_mapping[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert path(process.out.fasta[0][1]).linesGzip[0].startsWith('>sp|') }
            )
        }

    }

    test("no input - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [] ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
